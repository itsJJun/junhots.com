// Cloudflare settings: serve public/ as the website, and run src/worker.js for /api/* (Jun's builds editor) and /builds/* (hero link previews).
{
  "name": "junhots",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/builds/*"]
  },
  // Storage for "Jun's builds". The id comes from Cloudflare: Storage & databases -> KV.
  "kv_namespaces": [
    { "binding": "BUILDS", "id": "cb4d84ddab184520be1376c94f16a8d3" }
  ]
}

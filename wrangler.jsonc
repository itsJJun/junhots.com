// Cloudflare settings: serve public/ as the website, and run src/worker.js for /api/* (Jun's builds editor, tier list, games), /builds/* (hero link previews) and /sitemap.xml.
{
  "name": "junhots",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/builds/*", "/sitemap.xml"]
  },
  // Storage for "Jun's builds". The id comes from Cloudflare: Storage & databases -> KV.
  // Keep the plain variables typed in the Cloudflare dashboard (like TURNSTILE_SITEKEY for the feedback form)
  // when a push deploys; without this each deploy would remove them. Secrets are always kept.
  "keep_vars": true,
  // Feedback form: at most 3 sends per visitor per minute, checked before anything touches storage (src/feedback.js)
  "ratelimits": [
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  "kv_namespaces": [
    { "binding": "BUILDS", "id": "cb4d84ddab184520be1376c94f16a8d3" }
  ]
}

// Cloudflare settings: serve public/ as the website, and run src/worker.js for /api/* (Jun's builds editor, tier list, games, community tier list), /builds/* (hero link previews) and /sitemap.xml.
{
  "name": "junhots",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/builds/*", "/sitemap.xml"]
  },
  // Storage for "Jun's builds". The id comes from Cloudflare: Storage & databases -> KV.
  // Keep the plain variables typed in the Cloudflare dashboard (like TURNSTILE_SITEKEY for the feedback form)
  // when a push deploys; without this each deploy would remove them. Secrets are always kept.
  "keep_vars": true,
  // Feedback form: at most 3 sends per visitor per minute, checked before anything touches storage (src/feedback.js)
  "ratelimits": [
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    // Community tier list (src/community.js): the tier list maker sends a visitor's list at most a few times a minute
    { "name": "COMMUNITY_LIMIT", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } },
    // Visit and click counts (src/stats.js): a visitor sends one per page view or click, so a few dozen a minute is plenty
    { "name": "HIT_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  // Visit and click counts for Jun's /stats/ page live in one Durable Object with a small SQLite table (src/stats.js).
  // Cloudflare makes it on the next deploy by itself; nothing to set up in the dashboard.
  "durable_objects": { "bindings": [{ "name": "STATS", "class_name": "Stats" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Stats"] }],
  // Once a day: refresh the Twitch login the schedule editor uses (src/schedule.js), so it never runs out
  "triggers": { "crons": ["17 9 * * *", "41 * * * *"] },
  "kv_namespaces": [
    { "binding": "BUILDS", "id": "cb4d84ddab184520be1376c94f16a8d3" }
  ]
}
